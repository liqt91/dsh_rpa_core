.venv/
__pycache__/
*.py[cod]
.pytest_cache/
# 受限执行环境下 pytest 的兜底 basetemp（见 tests/conftest.py）
.pytest_tmp/
.ruff_cache/
dist/
build/
run_artifacts/
examples/api-usage/artifacts/
playwright-report/
test-results/
.DS_Store

_tmp_*/
/elements/

# 本地 agent 技能目录
/.agents/

# 本地 agent 记忆目录
/.workbuddy/

# Node.js
node_modules/
.trae/

# IDE 本机代码索引（10MB 级二进制图数据库，仅本地，不入库）
.codebase-memory/

# 本机扩展配对 token（TOFU 生成/采纳，含本机凭据，不应入库）
.capture-extension-token

# PySide6 GUI 可行性 demo 的离屏截图（仅本地预览，不入库）
.harness/demo/*.png

# 仓库根的临时文件（前几轮排障/探针留下的一次性备份与脚本，仅本地；
# 删除守卫在本机故障，无法用 rm 清理，故以忽略收口而不是删除）
/_bak_*
/_[a-z]*_*.txt
/_m[0-9]*
/_m[0-9]*.txt
/_probe_*
/_rewrite_*
/_n*.txt
/_neg*.txt
/_nv_*
/_p[0-9]*
/_t.txt
/_t2.txt
/_commit_msg*.txt*
# `.harness/spike/` 下的**下划线前缀**文件一律是本机 scratch：负向验证探针的产物、
# 门禁逐条取证的日志、一次性诊断脚本、渲染出的面板截图、临时记事等。
# 实测该目录下**没有**任何被跟踪的 `_` 前缀文件——证据件是**不带下划线**的
# `probe_*.py` / `add_l2_*.py`（源码注释按名引用它们，故必须留）。删除守卫在本机
# 故障（rm 被 fail-closed 拦下），照惯例以忽略收口而不是删除。
/.harness/spike/_*
# 门禁逐条取证时重定向到仓库根的日志（§ 门禁：输出重定向到文件再读）
/_gate_*.log
