.venv/
__pycache__/
*.py[cod]
.pytest_cache/
# 受限执行环境下 pytest 的兜底 basetemp（见 tests/conftest.py）
.pytest_tmp/
.ruff_cache/
dist/
build/
run_artifacts/
examples/api-usage/artifacts/
playwright-report/
test-results/
.DS_Store

_tmp_*/
/elements/

# 本地 agent 技能目录
/.agents/

# 本地 agent 记忆目录
/.workbuddy/

# Node.js
node_modules/
.trae/

# IDE 本机代码索引（10MB 级二进制图数据库，仅本地，不入库）
.codebase-memory/

# 本机扩展配对 token（TOFU 生成/采纳，含本机凭据，不应入库）
.capture-extension-token

# PySide6 GUI 可行性 demo 的离屏截图（仅本地预览，不入库）
.harness/demo/*.png

# 仓库根的临时文件（前几轮排障/探针留下的一次性备份与脚本，仅本地；
# 删除守卫在本机故障，无法用 rm 清理，故以忽略收口而不是删除）
/_bak_*
/_[a-z]*_*.txt
/_m[0-9]*
/_m[0-9]*.txt
/_probe_*
/_rewrite_*
/_n*.txt
/_neg*.txt
/_nv_*
/_p[0-9]*
/_t.txt
/_t2.txt
/_commit_msg*.txt*
/.harness/spike/_m[0-9]*
/.harness/spike/_m4*
/.harness/spike/_m5*
/.harness/spike/_nv_*
# 负向验证探针的运行产物（junitxml 报告 / 日志 / stdout）：同上，以忽略收口
/.harness/spike/_expr_controls_*
/.harness/spike/_summary_readability_*
/.harness/spike/_ref_groups_*
/.harness/spike/_fx_menu_probe*
/.harness/spike/_pytest_*
/.harness/spike/_probe_*
# 一次性诊断脚本（打印真实中间态用，结论已写进探针/任务文档，脚本本身不留）
/.harness/spike/_diag_*
# 只读探针渲染出的参数面板截图（本地核对行高/对齐用，仅本地）
/.harness/spike/_panel_*
# 门禁逐条取证时重定向到仓库根的日志（§ 门禁：输出重定向到文件再读）
/_gate_*.log
/.harness/spike/_gate_*.log
