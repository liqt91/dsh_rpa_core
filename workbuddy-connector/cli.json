{
  "runtime": {
    "type": "python",
    "version": "3.12"
  },
  "init": {
    "darwin": "python -m pip install rpa-core-runtime",
    "linux": "python -m pip install rpa-core-runtime",
    "win32": "python -m pip install rpa-core-runtime && rpa-core.exe install-extension"
  },
  "auth": {
    "darwin": "rpa-core auth",
    "linux": "rpa-core auth",
    "win32": "rpa-core.exe auth"
  },
  "unAuth": {
    "darwin": "rpa-core unauth",
    "linux": "rpa-core unauth",
    "win32": "rpa-core.exe unauth"
  },
  "status": {
    "darwin": "rpa-core status",
    "linux": "rpa-core status",
    "win32": "rpa-core.exe status"
  },
  "statusMatch": "\"status\": \"ready\""
}
