{
  "id": "workflow.sleep",
  "version": "1.0.0",
  "executor": "python.worker",
  "kind": "action",
  "risk": "read",
  "capabilities": [],
  "resources": [],
  "stability": "stable",
  "effect": {"kind": "pure", "replay": "safe", "idempotency": "none"},
  "input_schema": {
    "type": "object",
    "required": ["seconds"],
    "properties": {
      "seconds": {"type": "number", "minimum": 0, "description": "延时秒数，支持小数（如 0.5）"}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["sleptMs"],
    "properties": {"sleptMs": {"type": "integer"}},
    "additionalProperties": false
  },
  "x-outputs": {
    "sleptMs": {"label": "已延时毫秒数", "primary": true}
  },
  "errors": ["INVALID_INPUT", "SCRIPT_FAILED", "TIMEOUT", "CANCELLED"],
  "implementation": {"handler": "python.worker:workflow_sleep"},
  "default_timeout_seconds": 60,
  "retryable": false
}