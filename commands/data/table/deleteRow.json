{
  "id": "data.table.deleteRow",
  "version": "1.0.0",
  "executor": "python.worker",
  "kind": "action",
  "risk": "workflow-edit",
  "capabilities": [],
  "resources": [],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {
    "type": "object",
    "required": ["row"],
    "properties": {
      "flowDir": {"type": "string", "x-hidden": true, "description": "流程目录（运行时自动注入）。"},
      "table": {"type": "string", "default": "default", "description": "数据表格名称（当前固定为 default）。"},
      "row": {"type": "integer", "minimum": 1, "x-fx": true, "description": "要删除的行号（从 1 开始），越界将报错。"}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["rowCount"],
    "properties": {"rowCount": {"type": "integer"}},
    "additionalProperties": false
  },
  "x-outputs": {
    "rowCount": {"label": "删除后的总行数"}
  },
  "x-runtime": {"inject": ["flowDir"]},
  "errors": ["INVALID_INPUT", "TIMEOUT", "CANCELLED"],
  "implementation": {"handler": "python.worker:table_delete_row"},
  "default_timeout_seconds": 15,
  "retryable": false
}