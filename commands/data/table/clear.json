{
  "id": "data.table.clear",
  "version": "1.0.0",
  "executor": "python.worker",
  "kind": "action",
  "risk": "workflow-edit",
  "capabilities": [],
  "resources": [],
  "stability": "stable",
  "effect": {"kind": "idempotent-write", "replay": "idempotent", "idempotency": "derived"},
  "input_schema": {
    "type": "object",
    "required": [],
    "properties": {
      "flowDir": {"type": "string", "x-hidden": true, "description": "流程目录（运行时自动注入）。"},
      "table": {"type": "string", "default": "default", "description": "数据表格名称（当前固定为 default）。"}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["rowCount"],
    "properties": {"rowCount": {"type": "integer"}},
    "additionalProperties": false
  },
  "x-outputs": {
    "rowCount": {"label": "清空后的行数(0)"}
  },
  "x-runtime": {"inject": ["flowDir"]},
  "errors": ["INVALID_INPUT", "TIMEOUT", "CANCELLED"],
  "implementation": {"handler": "python.worker:table_clear"},
  "default_timeout_seconds": 15,
  "retryable": true
}