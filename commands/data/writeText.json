{
  "id": "data.writeText",
  "version": "1.0.0",
  "executor": "python.worker",
  "kind": "action",
  "risk": "workflow-edit",
  "capabilities": ["workspace.write"],
  "resources": ["workspace.filesystem"],
  "stability": "stable",
  "effect": {"kind": "idempotent-write", "replay": "idempotent", "idempotency": "derived"},
  "input_schema": {
    "type": "object",
    "required": ["workspace", "path"],
    "oneOf": [
      {"required": ["text"], "not": {"required": ["lines"]}},
      {"required": ["lines"], "not": {"required": ["text"]}}
    ],
    "properties": {
      "workspace": {"type": "string", "minLength": 1},
      "path": {"type": "string", "minLength": 1},
      "text": {"type": "string"},
      "lines": {"type": "array", "items": {"type": "string"}}
    },
    "additionalProperties": false
  },
  "output_schema": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}}, "additionalProperties": false},
  "x-outputs": {
    "path": {"label": "文件路径", "primary": true}
  },
  "errors": ["CAPABILITY_DENIED", "SCRIPT_FAILED", "TIMEOUT", "CANCELLED"],
  "implementation": {"handler": "python.worker:write_text"},
  "default_timeout_seconds": 15,
  "retryable": false
}
