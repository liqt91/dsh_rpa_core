{
  "id": "data.deletePath",
  "version": "1.0.0",
  "executor": "python.worker",
  "kind": "action",
  "risk": "workflow-edit",
  "capabilities": ["workspace.write"],
  "resources": ["workspace.filesystem"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {
    "type": "object",
    "required": ["workspace", "path"],
    "properties": {
      "workspace": {"type": "string", "minLength": 1},
      "path": {"type": "string", "minLength": 1},
      "recursive": {"type": "boolean", "default": false}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["deleted", "path"],
    "properties": {"deleted": {"type": "boolean"}, "path": {"type": "string"}},
    "additionalProperties": false
  },
  "x-outputs": {
    "deleted": {"label": "是否删除", "primary": true}
  },
  "errors": ["CAPABILITY_DENIED", "INVALID_INPUT", "SCRIPT_FAILED", "TIMEOUT", "CANCELLED"],
  "implementation": {"handler": "python.worker:delete_path"},
  "default_timeout_seconds": 15,
  "retryable": false
}