{
  "id": "data.format",
  "version": "1.0.0",
  "executor": "python.worker",
  "kind": "transform",
  "risk": "read",
  "capabilities": [],
  "resources": [],
  "stability": "stable",
  "effect": {"kind": "pure", "replay": "safe", "idempotency": "none"},
  "input_schema": {
    "type": "object",
    "required": ["template", "values"],
    "properties": {
      "template": {"type": "string", "minLength": 1},
      "values": {"type": "object"}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["text"],
    "properties": {"text": {"type": "string"}},
    "additionalProperties": false
  },
  "errors": ["INVALID_INPUT", "TIMEOUT", "CANCELLED"],
  "implementation": {"handler": "python.worker:format"},
  "default_timeout_seconds": 15,
  "retryable": true
}
