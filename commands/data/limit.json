{
  "id": "data.limit",
  "version": "1.0.0",
  "executor": "python.worker",
  "kind": "transform",
  "risk": "read",
  "capabilities": [],
  "resources": [],
  "stability": "stable",
  "effect": {"kind": "pure", "replay": "safe", "idempotency": "none"},
  "input_schema": {
    "type": "object",
    "required": ["items", "count"],
    "properties": {
      "items": {"type": "array"},
      "count": {"type": "integer", "minimum": 0}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["items", "count"],
    "properties": {
      "items": {"type": "array"},
      "count": {"type": "integer", "minimum": 0}
    },
    "additionalProperties": false
  },
  "errors": ["INVALID_INPUT", "TIMEOUT", "CANCELLED"],
  "implementation": {"handler": "python.worker:limit"},
  "default_timeout_seconds": 15,
  "retryable": true
}
