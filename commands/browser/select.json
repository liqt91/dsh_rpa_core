{
  "id": "browser.select",
  "x-palette-order": 14,
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "action",
  "risk": "browser-control",
  "capabilities": ["browser.control"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["selector", "value"], "properties": {"sessionId": {"type": "string"}, "selector": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1, "description": "选择项的值/标签/索引"}, "selectBy": {"type": "string", "enum": ["value", "label", "index"], "description": "选择方式", "default": "value"}, "timeoutMs": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["matchedCount", "sessionId"], "properties": {"matchedCount": {"type": "integer", "minimum": 1}, "sessionId": {"type": "string"}}, "additionalProperties": false},
  "x-outputs": {
    "matchedCount": {"label": "匹配数量"},
    "sessionId": {"label": "浏览器实例"}
  },
  "errors": ["ELEMENT_NOT_FOUND", "SESSION_NOT_FOUND", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "browser.playwright:selectOption"},
  "default_timeout_seconds": 15,
  "retryable": false
}
