{
  "id": "browser.launch",
  "version": "1.1.0",
  "executor": "browser.playwright",
  "kind": "lifecycle",
  "risk": "process-start",
  "capabilities": ["browser.control", "process.start"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "session", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {
    "type": "object",
    "properties": {
      "headless": {"type": "boolean"},
      "userAgent": {"type": "string", "minLength": 1},
      "userDataDir": {"type": "string", "minLength": 1},
      "transport": {
        "type": "string",
        "enum": ["playwright", "bsk"],
        "description": "playwright=独立自动化浏览器（默认，headless/userAgent/userDataDir 生效）；bsk=BrowserSkill 单扩展，复用用户真实已登录浏览器（Agent Window），能力差异：CSS selector only、仅主 frame（iframe 不支持）；headless/userAgent/userDataDir 在 bsk 下被忽略"
      },
      "browserInstanceId": {
        "type": "string",
        "minLength": 1,
        "description": "bsk 传输专用：多浏览器在线时指定实例（bsk browsers 查询）"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {"type": "object", "required": ["sessionId"], "properties": {"sessionId": {"type": "string"}}, "additionalProperties": false},
  "errors": ["EXECUTOR_FAILED", "TIMEOUT", "CANCELLED"],
  "implementation": {"handler": "browser.playwright:launch"},
  "default_timeout_seconds": 30,
  "retryable": false
}
