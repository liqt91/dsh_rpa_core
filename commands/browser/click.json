{
  "id": "browser.click",
  "x-palette-order": 12,
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "action",
  "risk": "browser-control",
  "capabilities": [
    "browser.control"
  ],
  "resources": [
    "browser.session"
  ],
  "stability": "stable",
  "effect": {
    "kind": "unsafe-write",
    "replay": "unsafe",
    "idempotency": "none"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "selector"
    ],
    "properties": {
      "sessionId": {
        "type": "string"
      },
      "selector": {
        "type": "string",
        "minLength": 1
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1
      },
      "clickType": {
        "type": "string",
        "enum": [
          "single",
          "double"
        ],
        "x-enum-labels": {
          "single": "单击",
          "double": "双击"
        },
        "description": "点击方式：single=单击，double=双击",
        "default": "single"
      },
      "button": {
        "type": "string",
        "enum": [
          "left",
          "right",
          "middle"
        ],
        "x-enum-labels": {
          "left": "左键",
          "right": "右键",
          "middle": "中键"
        },
        "description": "鼠标按钮",
        "default": "left"
      },
      "modifiers": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "Alt",
            "Ctrl",
            "Shift",
            "Win"
          ]
        },
        "description": "辅助按键组合",
        "default": []
      },
      "simulateHuman": {
        "type": "boolean",
        "description": "模拟人工点击：true=派发完整鼠标按键事件链（mousedown→mouseup→click，兼容只监听 mousedown/mouseup 的页面）；false=最短路径直接调 el.click()（更快，但只有 click 事件）。两者都是合成事件（isTrusted=false），页面脚本可识别、不能绕过风控；确需真人等价事件时把「点击注入通道」改成 cdp。元素被遮挡时会直接报 ELEMENT_COVERED。false 仅对左键单击、无辅助按键生效——右键/中键/双击/带辅助键时仍走事件链",
        "default": true
      },
      "clickPosition": {
        "type": "string",
        "enum": [
          "center",
          "random"
        ],
        "x-enum-labels": {
          "center": "元素中心",
          "random": "随机位置"
        },
        "description": "点击位置：center=元素中心（默认）；random=元素内随机位置（中心 ±35% 区间，风控/热力图类页面用）。坐标会写进事件的 clientX/clientY；元素部分在视口外时按「元素与视口的交集」取点，交集为空则报 ELEMENT_NOT_VISIBLE",
        "default": "center"
      },
      "injection": {
        "type": "string",
        "enum": [
          "dom",
          "cdp"
        ],
        "x-enum-labels": {
          "dom": "页面内合成事件",
          "cdp": "调试协议真事件"
        },
        "description": "点击事件的注入通道。dom=扩展在页面内 dispatchEvent 派发合成事件（isTrusted=false，最快，但页面能识别出事件不是人点的）；cdp=经 chrome.debugger 的 Input.dispatchMouseEvent 由浏览器自己生成事件（isTrusted=true，与真实鼠标点击无法区分，适用于只信任真事件的页面/风控场景）。cdp 需要扩展 0.9.6 及以上，点击瞬间浏览器顶部会短暂出现调试提示横幅；injection=cdp 时 simulateHuman 不生效（真事件链固定完整），改用 hoverMode / pressDelayMs / detachAfter 调节拟人度",
        "default": "dom"
      },
      "hoverMode": {
        "type": "string",
        "enum": [
          "before",
          "none"
        ],
        "x-enum-labels": {
          "before": "点击前先悬停",
          "none": "不悬停直接点击"
        },
        "description": "仅 injection=cdp 生效：点击前是否先派发 mouseMoved。before=先悬停到目标点（默认，兼容依赖 mouseover 才展开的下拉/菜单）；none=不悬停直接按下（适配 hover 和 click 都会触发同一动作的组件——这类组件先 hover 展开、再 click 会 toggle 关掉，表现为「一闪而过」）。dom 通道本身不派发 mouseMoved，此参数对其无影响",
        "default": "before"
      },
      "pressDelayMs": {
        "type": "integer",
        "minimum": 0,
        "description": "仅 injection=cdp 生效：鼠标按下到抬起之间的间隔（毫秒，上限 2000）。默认 0 表示不额外等待（保持历史行为）；设为 40~120 更接近真人按键时长。dom 通道无此参数",
        "default": 0
      },
      "detachAfter": {
        "type": "boolean",
        "description": "仅 injection=cdp 生效：点击后是否立即断开调试会话。默认 true（保持历史行为，避免浏览器顶部调试横幅久留）；设为 false 可复用同一条调试会话，减少连续点击时的横幅闪烁，也避免 detach 引发的失焦关闭浮层",
        "default": true
      },
      "postDelayMs": {
        "type": "integer",
        "minimum": 0,
        "description": "执行后延迟（毫秒）",
        "default": 0
      }
    },
    "additionalProperties": false,
    "x-param-groups": [
      {"label": "常规", "auto": true},
      {"label": "拟人化", "collapsed": true, "fields": ["injection", "simulateHuman", "hoverMode", "pressDelayMs", "detachAfter"]}
    ],
    "x-depends": {
      "simulateHuman": {"injection": "dom"},
      "hoverMode": {"injection": "cdp"},
      "pressDelayMs": {"injection": "cdp"},
      "detachAfter": {"injection": "cdp"}
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "matchedCount",
      "sessionId"
    ],
    "properties": {
      "matchedCount": {
        "type": "integer",
        "minimum": 1
      },
      "sessionId": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "x-outputs": {
    "matchedCount": {
      "label": "匹配数量"
    },
    "sessionId": {
      "label": "浏览器实例"
    }
  },
  "errors": [
    "ELEMENT_NOT_FOUND",
    "SESSION_NOT_FOUND",
    "TIMEOUT",
    "CANCELLED",
    "EXECUTOR_FAILED",
    "ELEMENT_COVERED",
    "ELEMENT_DISABLED",
    "ELEMENT_NOT_VISIBLE",
    "EXTENSION_OUTDATED"
  ],
  "implementation": {
    "handler": "browser.playwright:click"
  },
  "default_timeout_seconds": 15,
  "retryable": false
}
