{
  "id": "browser.click",
  "x-palette-order": 10,
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "action",
  "risk": "browser-control",
  "capabilities": ["browser.control"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["selector"], "properties": {"sessionId": {"type": "string"}, "selector": {"type": "string", "minLength": 1}, "timeoutMs": {"type": "integer", "minimum": 1}, "clickType": {"type": "string", "enum": ["single", "double"], "description": "点击方式：single=单击，double=双击", "default": "single"}, "button": {"type": "string", "enum": ["left", "right", "middle"], "description": "鼠标按钮", "default": "left"}, "modifiers": {"type": "array", "items": {"type": "string", "enum": ["Alt", "Ctrl", "Shift", "Win"]}, "description": "辅助按键组合", "default": []}, "simulateHuman": {"type": "boolean", "description": "模拟人工点击：true=派发完整鼠标按键事件链（mousedown→mouseup→click，兼容只监听 mousedown/mouseup 的页面）；false=最短路径直接调 el.click()（更快，但只有 click 事件）。两者都是合成事件（isTrusted=false），不能绕过风控；元素被遮挡时会直接报 ELEMENT_COVERED。false 仅对左键单击、无辅助按键生效——右键/中键/双击/带辅助键时仍走事件链", "default": true}, "clickPosition": {"type": "string", "enum": ["center", "random"], "description": "点击位置：center=元素中心（默认）；random=元素内随机位置（中心 ±35% 区间，风控/热力图类页面用）。坐标会写进事件的 clientX/clientY；元素部分在视口外时按「元素与视口的交集」取点，交集为空则报 ELEMENT_NOT_VISIBLE", "default": "center"}, "postDelayMs": {"type": "integer", "minimum": 0, "description": "执行后延迟（毫秒）", "default": 0}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["matchedCount", "sessionId"], "properties": {"matchedCount": {"type": "integer", "minimum": 1}, "sessionId": {"type": "string"}}, "additionalProperties": false},
  "x-outputs": {
    "matchedCount": {"label": "匹配数量"},
    "sessionId": {"label": "浏览器实例"}
  },
  "errors": ["ELEMENT_NOT_FOUND", "SESSION_NOT_FOUND", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED", "ELEMENT_COVERED", "ELEMENT_DISABLED", "ELEMENT_NOT_VISIBLE"],
  "implementation": {"handler": "browser.playwright:click"},
  "default_timeout_seconds": 15,
  "retryable": false
}
