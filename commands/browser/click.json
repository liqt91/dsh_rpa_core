{
  "id": "browser.click",
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "action",
  "risk": "browser-control",
  "capabilities": ["browser.control"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["selector"], "properties": {"sessionId": {"type": "string"}, "selector": {"type": "string", "minLength": 1}, "timeoutMs": {"type": "integer", "minimum": 1}, "clickType": {"type": "string", "enum": ["single", "double"], "description": "点击方式：single=单击，double=双击", "default": "single"}, "button": {"type": "string", "enum": ["left", "right", "middle"], "description": "鼠标按钮", "default": "left"}, "modifiers": {"type": "array", "items": {"type": "string", "enum": ["Alt", "Ctrl", "Shift", "Win"]}, "description": "辅助按键组合", "default": []}, "simulateHuman": {"type": "boolean", "description": "模拟人工点击（待元素被遮挡时可用）", "default": true}, "clickPosition": {"type": "string", "enum": ["center", "random"], "description": "点击位置：center=元素中心，random=元素内随机位置", "default": "center"}, "postDelayMs": {"type": "integer", "minimum": 0, "description": "执行后延迟（毫秒）", "default": 0}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["matchedCount", "sessionId"], "properties": {"matchedCount": {"type": "integer", "minimum": 1}, "sessionId": {"type": "string"}}, "additionalProperties": false},
  "x-outputs": {
    "matchedCount": {"label": "匹配数量"},
    "sessionId": {"label": "浏览器实例"}
  },
  "errors": ["ELEMENT_NOT_FOUND", "SESSION_NOT_FOUND", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "browser.playwright:click"},
  "default_timeout_seconds": 15,
  "retryable": false
}
