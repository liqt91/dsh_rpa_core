{
  "version": "1.0.0",
  "executor": "browser.playwright",
  "resources": [
    "browser.session"
  ],
  "stability": "stable",
  "id": "browser.waitLoad",
  "x-palette-order": 6,
  "kind": "query",
  "risk": "read",
  "capabilities": [
    "browser.read"
  ],
  "effect": {
    "kind": "read",
    "replay": "safe",
    "idempotency": "none"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "sessionId"
    ],
    "properties": {
      "sessionId": {
        "type": "string"
      },
      "state": {
        "type": "string",
        "enum": [
          "load",
          "domcontentloaded",
          "networkidle"
        ],
        "description": "等待的加载状态",
        "default": "load"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "url"
    ],
    "properties": {
      "url": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "x-outputs": {
    "url": {
      "label": "当前网址",
      "primary": true
    }
  },
  "errors": [
    "SESSION_NOT_FOUND",
    "TIMEOUT",
    "CANCELLED",
    "EXECUTOR_FAILED"
  ],
  "implementation": {
    "handler": "browser.playwright:waitLoad"
  },
  "default_timeout_seconds": 30,
  "retryable": true
}
