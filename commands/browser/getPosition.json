{
  "id": "browser.getPosition",
  "x-palette-order": 21,
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "query",
  "risk": "read",
  "capabilities": [
    "browser.read"
  ],
  "resources": [
    "browser.session"
  ],
  "stability": "stable",
  "effect": {
    "kind": "read",
    "replay": "safe",
    "idempotency": "none"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "selector"
    ],
    "properties": {
      "sessionId": {
        "type": "string"
      },
      "selector": {
        "type": "string",
        "minLength": 1
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "x",
      "y",
      "width",
      "height"
    ],
    "properties": {
      "x": {
        "type": "number"
      },
      "y": {
        "type": "number"
      },
      "width": {
        "type": "number"
      },
      "height": {
        "type": "number"
      }
    },
    "additionalProperties": false
  },
  "x-outputs": {
    "x": {
      "label": "X 坐标",
      "primary": true
    },
    "y": {
      "label": "Y 坐标"
    },
    "width": {
      "label": "宽度"
    },
    "height": {
      "label": "高度"
    }
  },
  "errors": [
    "ELEMENT_NOT_FOUND",
    "SESSION_NOT_FOUND",
    "TIMEOUT",
    "CANCELLED",
    "EXECUTOR_FAILED"
  ],
  "implementation": {
    "handler": "browser.playwright:getPosition"
  },
  "default_timeout_seconds": 15,
  "retryable": true
}