{
  "id": "browser.getPosition",
  "x-palette-order": 23,
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "query",
  "risk": "read",
  "capabilities": [
    "browser.read"
  ],
  "resources": [
    "browser.session"
  ],
  "stability": "stable",
  "effect": {
    "kind": "read",
    "replay": "safe",
    "idempotency": "none"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "selector"
    ],
    "properties": {
      "sessionId": {
        "type": "string"
      },
      "selector": {
        "type": "string",
        "minLength": 1
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "x",
      "y",
      "width",
      "height",
      "right",
      "bottom",
      "centerX",
      "centerY"
    ],
    "properties": {
      "x": {
        "type": "number",
        "description": "左边距（相对浏览器页面左上角，即客户区域；屏幕坐标未支持）"
      },
      "y": {
        "type": "number",
        "description": "顶部边距（相对浏览器页面左上角，即客户区域；屏幕坐标未支持）"
      },
      "width": {
        "type": "number"
      },
      "height": {
        "type": "number"
      },
      "right": {
        "type": "number",
        "description": "右边距（x + width，相对浏览器页面左上角）"
      },
      "bottom": {
        "type": "number",
        "description": "底部边距（y + height，相对浏览器页面左上角）"
      },
      "centerX": {
        "type": "number",
        "description": "中心点横坐标（x + width / 2，相对浏览器页面左上角）"
      },
      "centerY": {
        "type": "number",
        "description": "中心点纵坐标（y + height / 2，相对浏览器页面左上角）"
      }
    },
    "additionalProperties": false
  },
  "x-outputs": {
    "x": {
      "label": "X 坐标",
      "primary": true
    },
    "y": {
      "label": "Y 坐标"
    },
    "width": {
      "label": "宽度"
    },
    "height": {
      "label": "高度"
    },
    "right": {
      "label": "右边距"
    },
    "bottom": {
      "label": "底部边距"
    },
    "centerX": {
      "label": "中心点横坐标"
    },
    "centerY": {
      "label": "中心点纵坐标"
    }
  },
  "errors": [
    "ELEMENT_NOT_FOUND",
    "SESSION_NOT_FOUND",
    "TIMEOUT",
    "CANCELLED",
    "EXECUTOR_FAILED",
    "ELEMENT_COVERED",
    "ELEMENT_DISABLED",
    "ELEMENT_NOT_VISIBLE"
  ],
  "implementation": {
    "handler": "browser.playwright:getPosition"
  },
  "default_timeout_seconds": 15,
  "retryable": true
}