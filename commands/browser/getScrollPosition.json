{
  "id": "browser.getScrollPosition",
  "x-palette-order": 30,
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "query",
  "risk": "read",
  "capabilities": [
    "browser.read"
  ],
  "resources": [
    "browser.session"
  ],
  "stability": "stable",
  "effect": {
    "kind": "read",
    "replay": "safe",
    "idempotency": "none"
  },
  "input_schema": {
    "type": "object",
    "required": [],
    "properties": {
      "sessionId": {
        "type": "string"
      },
      "selector": {
        "type": "string",
        "minLength": 1,
        "description": "可选：指定内部有独立滚动条的元素，缺省读取整个页面的滚动位置"
      },
      "direction": {
        "type": "string",
        "enum": [
          "vertical",
          "horizontal"
        ], "x-enum-labels": {"vertical": "纵向", "horizontal": "横向"},
        "description": "滚动条方向（对标影刀「获取滚动条位置」的纵向/横向）：vertical=纵向（默认）；horizontal=横向。只影响 scrollPosition 的取轴，scrollX/scrollY 恒按各自轴返回",
        "default": "vertical"
      },
      "position": {
        "type": "string",
        "enum": [
          "current",
          "bottom"
        ], "x-enum-labels": {"current": "当前位置", "bottom": "底部位置"},
        "description": "取哪个位置（对标影刀「获取滚动条位置」的当前位置/底部位置）：current=当前位置（默认，即 scrollX/scrollY）；bottom=底部位置（即滚动条长度＝可滚动内容总长，取 scrollHeight/scrollWidth）。只影响 scrollPosition",
        "default": "current"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "scrollX",
      "scrollY",
      "scrollPosition"
    ],
    "properties": {
      "scrollX": {
        "type": "number",
        "description": "横向滚动位置（当前值，恒返回，不受 direction/position 影响）"
      },
      "scrollY": {
        "type": "number",
        "description": "纵向滚动位置（当前值，恒返回，不受 direction/position 影响）"
      },
      "scrollPosition": {
        "type": "number",
        "description": "按 direction 与 position 取定的滚动条位置：direction=vertical 时取 scrollY 或 scrollHeight，horizontal 时取 scrollX 或 scrollWidth"
      }
    },
    "additionalProperties": false
  },
  "x-outputs": {
    "scrollX": {
      "label": "横向滚动位置"
    },
    "scrollY": {
      "label": "纵向滚动位置",
      "primary": true
    },
    "scrollPosition": {
      "label": "滚动条位置"
    }
  },
  "errors": [
    "ELEMENT_NOT_FOUND",
    "SESSION_NOT_FOUND",
    "TIMEOUT",
    "CANCELLED",
    "EXECUTOR_FAILED",
    "ELEMENT_COVERED",
    "ELEMENT_DISABLED",
    "ELEMENT_NOT_VISIBLE"
  ],
  "implementation": {
    "handler": "browser.playwright:getScrollPosition"
  },
  "default_timeout_seconds": 15,
  "retryable": true
}