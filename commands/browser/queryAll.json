{
  "id": "browser.queryAll",
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "query",
  "risk": "read",
  "capabilities": ["browser.read"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "read", "replay": "safe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["sessionId", "selector"], "properties": {"sessionId": {"type": "string"}, "selector": {"type": "string", "minLength": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["items", "count"], "properties": {"items": {"type": "array", "items": {"type": "string"}}, "count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
  "errors": ["SESSION_NOT_FOUND", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "browser.playwright:query_all"},
  "default_timeout_seconds": 15,
  "retryable": true
}
