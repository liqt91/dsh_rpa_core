{
  "id": "browser.close",
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "lifecycle",
  "risk": "browser-control",
  "capabilities": ["browser.control"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "session", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["sessionId"], "properties": {"sessionId": {"type": "string"}}, "additionalProperties": false},
  "output_schema": {"type": "object", "additionalProperties": false},
  "errors": ["SESSION_NOT_FOUND", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "browser.playwright:close"},
  "default_timeout_seconds": 15,
  "retryable": false
}
