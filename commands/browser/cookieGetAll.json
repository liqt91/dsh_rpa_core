{
  "version": "1.0.0",
  "executor": "browser.playwright",
  "resources": [
    "browser.session"
  ],
  "stability": "stable",
  "id": "browser.cookieGetAll",
  "x-palette-order": 32,
  "kind": "query",
  "risk": "read",
  "capabilities": [
    "browser.read"
  ],
  "effect": {
    "kind": "read",
    "replay": "safe",
    "idempotency": "none"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "sessionId"
    ],
    "properties": {
      "sessionId": {
        "type": "string"
      },
      "name": {
        "type": "string",
        "description": "按名称精确筛选（可选）"
      },
      "domain": {
        "type": "string",
        "description": "按域筛选，支持子串匹配（可选）"
      },
      "path": {
        "type": "string",
        "description": "按路径筛选，支持子串匹配（可选）"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "cookies",
      "count"
    ],
    "properties": {
      "cookies": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "additionalProperties": false
  },
  "x-outputs": {
    "cookies": {
      "label": "Cookie 列表",
      "primary": true
    },
    "count": {
      "label": "数量"
    }
  },
  "errors": [
    "SESSION_NOT_FOUND",
    "TIMEOUT",
    "CANCELLED",
    "EXECUTOR_FAILED"
  ],
  "implementation": {
    "handler": "browser.playwright:cookieGetAll"
  },
  "default_timeout_seconds": 15,
  "retryable": false
}
