{
  "id": "browser.download",
  "x-palette-order": 39,
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "action",
  "risk": "browser-control",
  "capabilities": ["browser.control"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["saveDir"], "properties": {"sessionId": {"type": "string"}, "saveDir": {"type": "string", "minLength": 1, "description": "下载保存目录"}, "timeoutMs": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["filePath"], "properties": {"filePath": {"type": "string", "description": "下载文件的完整路径"}}, "additionalProperties": false},
  "x-outputs": {
    "filePath": {"label": "文件路径", "primary": true}
  },
  "errors": ["SESSION_NOT_FOUND", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "browser.playwright:download"},
  "default_timeout_seconds": 60,
  "retryable": false
}
