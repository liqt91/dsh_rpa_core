{
  "id": "browser.getText",
  "x-palette-order": 24,
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "query",
  "risk": "read",
  "capabilities": ["browser.read"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "read", "replay": "safe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["selector"], "properties": {"sessionId": {"type": "string"}, "selector": {"type": "string", "minLength": 1}, "infoType": {"type": "string", "enum": ["text", "html", "outerHTML", "value", "href", "attribute"], "description": "信息类型（对标影刀「获取元素信息」的操作项）：text=可见文本（默认）；html=元素内部 HTML；outerHTML=元素完整 HTML；value=表单值；href=链接地址；attribute=指定属性值（须配合 attributeName）", "default": "text"}, "attributeName": {"type": "string", "description": "属性名（infoType=attribute 时生效，对标影刀「获取元素属性」）：如 href、src、class、data-*；留空或属性不存在时返回空串"}, "completeUrlPrefix": {"type": "boolean", "description": "智能识别并补充地址前缀（仅 infoType=href 时生效，对标影刀同名选项）：取到的地址缺少协议头时按当前页面协议补 https:// 或 http://（以 // 开头则补「协议 + :」）", "default": false}, "timeoutMs": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["value"], "properties": {"value": {"type": "string"}}, "additionalProperties": false},
  "x-outputs": {
    "value": {"label": "文本内容", "primary": true, "description": "获取结果：随 infoType 为可见文本 / HTML / 表单值 / 链接地址 / 指定属性值，恒为字符串"}
  },
  "errors": ["ELEMENT_NOT_FOUND", "SESSION_NOT_FOUND", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED", "ELEMENT_COVERED", "ELEMENT_DISABLED", "ELEMENT_NOT_VISIBLE"],
  "implementation": {"handler": "browser.playwright:get_text"},
  "default_timeout_seconds": 15,
  "retryable": true
}
