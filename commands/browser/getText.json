{
  "id": "browser.getText",
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "query",
  "risk": "read",
  "capabilities": ["browser.read"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "read", "replay": "safe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["selector"], "properties": {"sessionId": {"type": "string"}, "selector": {"type": "string", "minLength": 1}, "timeoutMs": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["value"], "properties": {"value": {"type": "string"}}, "additionalProperties": false},
  "x-outputs": {
    "value": {"label": "文本内容", "primary": true}
  },
  "errors": ["ELEMENT_NOT_FOUND", "SESSION_NOT_FOUND", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "browser.playwright:get_text"},
  "default_timeout_seconds": 15,
  "retryable": true
}
