{
  "id": "browser.waitFor",
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "query",
  "risk": "read",
  "capabilities": ["browser.read"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "read", "replay": "safe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["selector"], "properties": {"sessionId": {"type": "string"}, "selector": {"type": "string", "minLength": 1}, "state": {"type": "string", "enum": ["visible", "hidden", "detached", "attached"], "description": "等待条件（对标影刀「等待元素」）：visible=可见（默认）；hidden=不可见；detached=从 DOM 移除；attached=存在于 DOM", "default": "visible"}, "timeoutMs": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["matchedCount"], "properties": {"matchedCount": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "x-outputs": {
    "matchedCount": {"label": "匹配数量", "primary": true}
  },
  "errors": ["ELEMENT_NOT_FOUND", "SESSION_NOT_FOUND", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "browser.playwright:wait_for"},
  "default_timeout_seconds": 15,
  "retryable": true
}
