{
  "id": "browser.navigate",
  "x-palette-order": 1,
  "version": "3.5.0",
  "executor": "browser.playwright",
  "kind": "action",
  "risk": "browser-control",
  "capabilities": [
    "browser.control",
    "process.start"
  ],
  "resources": [
    "browser.session"
  ],
  "stability": "stable",
  "effect": {
    "kind": "session",
    "replay": "unsafe",
    "idempotency": "none"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "browserType"
    ],
    "properties": {
      "browserType": {
        "type": "string",
        "enum": [
          "msedge",
          "chrome"
        ],
        "x-enum-labels": {
          "msedge": "Edge",
          "chrome": "Chrome"
        },
        "default": "msedge",
        "description": "指定由哪个浏览器的自研插件打开网页（Edge/Chrome）。Chrome 与 Edge 可各自安装插件，命令会路由到所选浏览器的插件执行；未安装插件的浏览器在编辑器中置灰，运行时会快速失败"
      },
      "action": {
        "type": "string",
        "enum": [
          "goto",
          "back",
          "forward",
          "reload"
        ],
        "x-enum-labels": {
          "goto": "打开新网址",
          "back": "后退",
          "forward": "前进",
          "reload": "重新加载（刷新）"
        },
        "description": "跳转方式（对标影刀「跳转至新网址」）：goto=打开新网页（默认，需 url，在用户真实浏览器里新建标签页）；back=后退；forward=前进；reload=重新加载（刷新），三者需提供已有 sessionId",
        "default": "goto"
      },
      "url": {
        "type": "string",
        "x-fx": true,
        "description": "目标网址（action=goto 必填）。可省略 http(s):// 前导协议（如填 baidu.com 自动补全为 https://baidu.com）"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1
      },
      "onTimeout": {
        "type": "string",
        "enum": [
          "error",
          "stop"
        ],
        "x-enum-labels": {
          "error": "报错（走错误处理）",
          "stop": "停止网页加载并继续"
        },
        "default": "error",
        "description": "加载超时后执行（对标影刀「加载超时后执行」）：页在 timeoutMs 内未加载完成时的处理——error=视为超时失败（走引擎错误处理，可配重试/忽略）；stop=停止网页加载并继续后续流程"
      },
      "commandLineArgs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "浏览器命令行参数（仅当目标浏览器离线自动拉起时生效，如 --user-data-dir=<独立配置目录> 以可靠注入插件、--incognito 等）；目标浏览器已在线时忽略"
      }
    },
    "additionalProperties": false,
    "x-param-groups": [
      {
        "label": "常规",
        "fields": [
          "browserType",
          "url",
          "action"
        ]
      },
      {
        "label": "高级",
        "fields": [
          "timeoutMs",
          "onTimeout",
          "commandLineArgs"
        ],
        "collapsed": true
      }
    ]
  },
  "output_schema": {
    "type": "object",
    "required": [
      "sessionId",
      "url",
      "resourceType"
    ],
    "properties": {
      "sessionId": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "resourceType": {
        "type": "string",
        "const": "webPage",
        "description": "资源类型标签：webPage=浏览器网页对象，windowHandle=桌面窗口句柄"
      },
      "browserInstance": {
        "type": ["string", "null"],
        "description": "实际创建该网页对象的浏览器实例唯一 id（同一 profile 多窗口同一 id，不同 profile 各自独立）"
      },
      "browserType": {
        "type": "string",
        "enum": ["msedge", "chrome"],
        "description": "打开时指定的浏览器类型"
      },
      "tabId": {
        "type": "string",
        "description": "该网页对象在浏览器里的标签页 id（浏览器进程内，跨运行可能变化，仅供定位）"
      }
    },
    "additionalProperties": false
  },
  "x-outputs": {
    "sessionId": {
      "label": "保存网页对象到",
      "primary": true
    },
    "url": {
      "label": "最终网址",
      "hidden": true
    },
    "resourceType": {
      "label": "资源类型",
      "hidden": true
    },
    "browserInstance": {
      "label": "浏览器实例",
      "primary": true
    },
    "browserType": {
      "label": "浏览器类型",
      "hidden": true
    },
    "tabId": {
      "label": "标签页 ID",
      "hidden": true
    }
  },
  "errors": [
    "TIMEOUT",
    "CANCELLED",
    "EXECUTOR_FAILED"
  ],
  "implementation": {
    "handler": "browser.playwright:navigate"
  },
  "default_timeout_seconds": 30,
  "retryable": false
}