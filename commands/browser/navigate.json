{
  "id": "browser.navigate",
  "version": "1.0.0",
  "executor": "browser.playwright",
  "kind": "action",
  "risk": "browser-control",
  "capabilities": ["browser.control"],
  "resources": ["browser.session"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["sessionId", "url"], "properties": {"sessionId": {"type": "string"}, "url": {"type": "string"}, "timeoutMs": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["url", "sessionId"], "properties": {"url": {"type": "string"}, "sessionId": {"type": "string"}}, "additionalProperties": false},
  "errors": ["SESSION_NOT_FOUND", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "browser.playwright:navigate"},
  "default_timeout_seconds": 30,
  "retryable": false
}
