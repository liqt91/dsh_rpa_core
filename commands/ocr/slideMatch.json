{
  "id": "ocr.slideMatch",
  "version": "1.0.0",
  "executor": "ocr.ddddocr",
  "kind": "query",
  "risk": "read",
  "capabilities": [],
  "resources": [],
  "stability": "stable",
  "effect": {"kind": "pure", "replay": "safe", "idempotency": "none"},
  "input_schema": {
    "type": "object",
    "properties": {
      "templateImagePath": {
        "type": "string",
        "x-fx": true,
        "description": "滑块块图（缺口那一块的图）的文件路径。与 templateImageBase64 二选一"
      },
      "templateImageBase64": {
        "type": "string",
        "description": "滑块块图的 Base64 内容。与 templateImagePath 二选一"
      },
      "backgroundImagePath": {
        "type": "string",
        "x-fx": true,
        "description": "带缺口的背景图的文件路径。与 backgroundImageBase64 二选一"
      },
      "backgroundImageBase64": {
        "type": "string",
        "description": "带缺口的背景图的 Base64 内容。与 backgroundImagePath 二选一"
      },
      "simpleTarget": {
        "type": "boolean",
        "default": false,
        "description": "块图是否为不带透明通道的简单块图。false 走边缘匹配、true 走原图模板匹配；不同站点的滑块风格命中率不同，可以两个都试"
      },
      "minConfidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0,
        "description": "可选严格模式：匹配相关度低于此值就报 EXECUTOR_FAILED。默认 0 = 不判，原样透传坐标"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["x", "y", "confidence"],
    "properties": {
      "x": {"type": "integer", "description": "缺口**中心**的横坐标（不是左边界）"},
      "y": {"type": "integer", "description": "缺口**中心**的纵坐标（不是上边界）"},
      "confidence": {"type": "number", "description": "归一化相关系数（-1~1），**不是概率**"}
    },
    "additionalProperties": false
  },
  "x-outputs": {
    "x": {"label": "缺口横坐标"},
    "y": {"label": "缺口纵坐标"},
    "confidence": {"label": "匹配相关度"}
  },
  "errors": ["INVALID_INPUT", "EXECUTOR_FAILED", "TIMEOUT", "CANCELLED"],
  "implementation": {"handler": "ocr.ddddocr:slideMatch"},
  "default_timeout_seconds": 60,
  "retryable": true
}
