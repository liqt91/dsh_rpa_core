{
  "id": "desktop.getSelectedText",
  "version": "1.0.0",
  "executor": "desktop.uia",
  "kind": "query",
  "risk": "read",
  "capabilities": ["desktop.control"],
  "resources": ["desktop.session", "desktop.element"],
  "stability": "stable",
  "effect": {"kind": "read", "replay": "safe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["elementId"], "properties": {"sessionId": {"type": "string", "minLength": 1}, "elementId": {"type": "string", "minLength": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}}, "additionalProperties": false},
  "x-outputs": {
    "text": {"label": "选中文本", "primary": true}
  },
  "errors": ["ELEMENT_NOT_FOUND", "SESSION_NOT_FOUND", "SESSION_LOST", "EXECUTOR_FAILED"],
  "implementation": {"handler": "desktop.uia:get_selected_text"},
  "default_timeout_seconds": 15,
  "retryable": false
}
