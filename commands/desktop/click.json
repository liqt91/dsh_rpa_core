{
  "id": "desktop.click",
  "version": "1.0.0",
  "executor": "desktop.uia",
  "kind": "action",
  "risk": "desktop-control",
  "capabilities": ["desktop.control"],
  "resources": ["desktop.session", "desktop.element"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["elementId"], "properties": {"sessionId": {"type": "string", "minLength": 1}, "elementId": {"type": "string", "minLength": 1}, "timeoutMs": {"type": "integer", "minimum": 1}, "clickType": {"type": "string", "enum": ["single", "double"], "description": "点击方式：single=单击，double=双击", "default": "single"}, "button": {"type": "string", "enum": ["left", "right"], "description": "鼠标按钮", "default": "left"}, "modifiers": {"type": "array", "items": {"type": "string", "enum": ["Alt", "Ctrl", "Shift", "Win"]}, "description": "辅助按键组合", "default": []}, "simulateHuman": {"type": "boolean", "description": "默认 true=真实鼠标路径（会移动光标，支持双击/非左键/辅助键/随机落点）；false=优先 invoke() 直接调用（不移动鼠标），仅对普通左键单击生效——双击/非左键/辅助键会自动退回真实鼠标路径，退回原因写入执行证据。与 clickPosition=random 互斥。", "default": true}, "clickPosition": {"type": "string", "enum": ["center", "random"], "description": "点击落点：center=元素中心（默认）；random=元素矩形内偏中心带的随机点，需要真实鼠标路径，因此与 simulateHuman=false 互斥（同时使用报 INVALID_INPUT）；元素 click_input() 不接受 coords 时退回中心并把原因写入执行证据。", "default": "center"}, "postDelayMs": {"type": "integer", "minimum": 0, "description": "执行后延迟（毫秒）", "default": 0}}, "additionalProperties": false},
  "output_schema": {"type": "object", "additionalProperties": false},
  "errors": ["INVALID_INPUT", "ELEMENT_NOT_FOUND", "SESSION_NOT_FOUND", "SESSION_LOST", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "desktop.uia:click"},
  "default_timeout_seconds": 15,
  "retryable": false
}
