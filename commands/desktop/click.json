{
  "id": "desktop.click",
  "version": "1.0.0",
  "executor": "desktop.uia",
  "kind": "action",
  "risk": "desktop-control",
  "capabilities": ["desktop.control"],
  "resources": ["desktop.session", "desktop.element"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["sessionId", "elementId"], "properties": {"sessionId": {"type": "string", "minLength": 1}, "elementId": {"type": "string", "minLength": 1}, "timeoutMs": {"type": "integer", "minimum": 1}, "clickType": {"type": "string", "enum": ["single", "double"], "description": "点击方式：single=单击，double=双击", "default": "single"}, "button": {"type": "string", "enum": ["left", "right"], "description": "鼠标按钮", "default": "left"}, "modifiers": {"type": "array", "items": {"type": "string", "enum": ["Alt", "Ctrl", "Shift", "Win"]}, "description": "辅助按键组合", "default": []}, "simulateHuman": {"type": "boolean", "description": "模拟人工点击", "default": true}, "clickPosition": {"type": "string", "enum": ["center", "random"], "description": "点击位置", "default": "center"}, "postDelayMs": {"type": "integer", "minimum": 0, "description": "执行后延迟（毫秒）", "default": 0}}, "additionalProperties": false},
  "output_schema": {"type": "object", "additionalProperties": false},
  "errors": ["ELEMENT_NOT_FOUND", "SESSION_NOT_FOUND", "SESSION_LOST", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "desktop.uia:click"},
  "default_timeout_seconds": 15,
  "retryable": false
}
