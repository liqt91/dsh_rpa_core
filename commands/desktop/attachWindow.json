{
  "id": "desktop.attachWindow",
  "version": "1.0.0",
  "executor": "desktop.uia",
  "kind": "lifecycle",
  "risk": "desktop-control",
  "capabilities": ["desktop.control"],
  "resources": ["desktop.session", "desktop.window"],
  "stability": "stable",
  "effect": {"kind": "session", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1}, "className": {"type": "string", "minLength": 1, "description": "窗口类型名（可选）"}, "processId": {"type": "integer", "minimum": 1, "description": "进程 ID（可选）"}, "matchMode": {"type": "string", "enum": ["exact", "contains", "regex"], "description": "标题匹配方式", "default": "exact"}, "timeoutMs": {"type": "integer", "minimum": 1}, "operationTimeoutMs": {"type": "integer", "minimum": 1, "description": "操作超时（毫秒），覆盖默认 15s；复杂桌面环境可增大"}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["sessionId", "resourceType", "processId", "workWindowId"], "properties": {"sessionId": {"type": "string"}, "resourceType": {"type": "string", "const": "windowHandle", "description": "资源类型标签：windowHandle=桌面窗口句柄，webPage=浏览器网页对象"}, "processId": {"type": "integer"}, "workWindowId": {"type": "string"}}, "additionalProperties": false},
  "x-outputs": {
    "sessionId": {"label": "窗口实例", "primary": true},
    "resourceType": {"label": "资源类型"},
    "processId": {"label": "进程ID"},
    "workWindowId": {"label": "窗口句柄"}
  },
  "errors": ["ELEMENT_NOT_FOUND", "ELEMENT_AMBIGUOUS", "TIMEOUT", "CANCELLED", "PLATFORM_UNSUPPORTED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "desktop.uia:attach_window"},
  "default_timeout_seconds": 15,
  "retryable": false
}
