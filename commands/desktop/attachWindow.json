{
  "id": "desktop.attachWindow",
  "version": "1.0.0",
  "executor": "desktop.uia",
  "kind": "lifecycle",
  "risk": "desktop-control",
  "capabilities": ["desktop.control"],
  "resources": ["desktop.session", "desktop.window"],
  "stability": "stable",
  "effect": {"kind": "session", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1}, "processId": {"type": "integer", "minimum": 1}, "timeoutMs": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["sessionId", "processId", "workWindowId"], "properties": {"sessionId": {"type": "string"}, "processId": {"type": "integer"}, "workWindowId": {"type": "string"}}, "additionalProperties": false},
  "errors": ["ELEMENT_NOT_FOUND", "ELEMENT_AMBIGUOUS", "TIMEOUT", "CANCELLED", "PLATFORM_UNSUPPORTED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "desktop.uia:attach_window"},
  "default_timeout_seconds": 15,
  "retryable": false
}
