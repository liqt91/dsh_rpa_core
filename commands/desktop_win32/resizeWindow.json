{
  "id": "desktop.win32.resizeWindow",
  "version": "1.0.0",
  "executor": "desktop.win32",
  "kind": "action",
  "risk": "desktop-control",
  "capabilities": ["desktop.control"],
  "resources": ["desktop.session", "desktop.window"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["width", "height"], "properties": {"sessionId": {"type": "string", "minLength": 1}, "width": {"type": "integer", "minimum": 1, "description": "窗口宽度"}, "height": {"type": "integer", "minimum": 1, "description": "窗口高度"}}, "additionalProperties": false},
  "output_schema": {"type": "object", "additionalProperties": false},
  "errors": ["SESSION_NOT_FOUND", "SESSION_LOST", "EXECUTOR_FAILED"],
  "implementation": {"handler": "desktop.win32:resize_window"},
  "default_timeout_seconds": 15,
  "retryable": false
}
