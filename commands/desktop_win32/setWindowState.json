{
  "id": "desktop.win32.setWindowState",
  "version": "1.0.0",
  "executor": "desktop.win32",
  "kind": "action",
  "risk": "desktop-control",
  "capabilities": ["desktop.control"],
  "resources": ["desktop.session", "desktop.window"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["sessionId"], "properties": {"sessionId": {"type": "string", "minLength": 1}, "state": {"type": "string", "enum": ["maximized", "minimized", "normal"], "description": "窗口状态", "default": "normal"}}, "additionalProperties": false},
  "output_schema": {"type": "object", "additionalProperties": false},
  "errors": ["SESSION_NOT_FOUND", "SESSION_LOST", "EXECUTOR_FAILED"],
  "implementation": {"handler": "desktop.win32:set_window_state"},
  "default_timeout_seconds": 15,
  "retryable": false
}
