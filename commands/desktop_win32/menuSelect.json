{
  "id": "desktop.win32.menuSelect",
  "version": "1.0.0",
  "executor": "desktop.win32",
  "kind": "action",
  "risk": "desktop-control",
  "capabilities": ["desktop.control"],
  "resources": ["desktop.session", "desktop.window"],
  "stability": "stable",
  "effect": {"kind": "unsafe-write", "replay": "unsafe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["menuPath"], "properties": {"sessionId": {"type": "string", "minLength": 1}, "menuPath": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "timeoutMs": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "additionalProperties": false},
  "errors": ["SESSION_NOT_FOUND", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "desktop.win32:menu_select"},
  "default_timeout_seconds": 15,
  "retryable": false
}
