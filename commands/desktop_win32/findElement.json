{
  "id": "desktop.win32.findElement",
  "version": "1.0.0",
  "executor": "desktop.win32",
  "kind": "query",
  "risk": "read",
  "capabilities": ["desktop.control"],
  "resources": ["desktop.session", "desktop.element"],
  "stability": "stable",
  "effect": {"kind": "read", "replay": "safe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["sessionId", "locator"], "properties": {"sessionId": {"type": "string", "minLength": 1}, "locator": {"type": "object", "minProperties": 1, "properties": {"backend": {"type": "string", "enum": ["win32"]}, "title": {"type": "string", "minLength": 1}, "className": {"type": "string", "minLength": 1}, "handle": {"type": "integer", "minimum": 1}, "controlId": {"type": "integer", "minimum": 1}, "foundIndex": {"type": "integer", "minimum": 0}, "menuPath": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}}, "additionalProperties": false}, "timeoutMs": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["elementId", "matchedCount"], "properties": {"elementId": {"type": "string"}, "matchedCount": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "errors": ["ELEMENT_NOT_FOUND", "ELEMENT_AMBIGUOUS", "SESSION_NOT_FOUND", "SESSION_LOST", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "desktop.win32:find_element"},
  "default_timeout_seconds": 15,
  "retryable": true
}
