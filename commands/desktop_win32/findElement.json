{
  "id": "desktop.win32.findElement",
  "version": "1.0.0",
  "executor": "desktop.win32",
  "kind": "query",
  "risk": "read",
  "capabilities": ["desktop.control"],
  "resources": ["desktop.session", "desktop.element"],
  "stability": "stable",
  "effect": {"kind": "read", "replay": "safe", "idempotency": "none"},
  "input_schema": {"type": "object", "required": ["locator"], "properties": {"sessionId": {"type": "string", "minLength": 1}, "locator": {"type": "object", "minProperties": 1, "properties": {"backend": {"type": "string", "enum": ["win32"]}, "title": {"type": "string", "minLength": 1}, "className": {"type": "string", "minLength": 1, "description": "控件类型名，等值比较（可选）；与 classNameRe 互斥"}, "classNameRe": {"type": "string", "minLength": 1, "description": "控件类型名的正则（search，非整串锚定），可选；写 WindowsForms10.LISTBOX 即可命中含机器级哈希的完整类名，跨机器可用；与 className 互斥"}, "handle": {"type": "integer", "minimum": 1}, "controlId": {"type": "integer", "minimum": 1}, "foundIndex": {"type": "integer", "minimum": 0}, "menuPath": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "matchMode": {"type": "string", "enum": ["exact", "contains", "regex"], "description": "控件级匹配方式（默认 exact）。uia 作用于 name/automationId；win32 作用于 title；controlType/className 恒等值"}, "path": {"type": "array", "minItems": 1, "description": "控件祖先链（从根窗口到目标的各级容器，不含目标本身）；逐级收窄搜索域", "items": {"type": "object", "minProperties": 1, "properties": {"controlType": {"type": "string", "minLength": 1}, "automationId": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "className": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "anchor": {"type": "object", "required": ["locator"], "description": "锚点：运行目标前先确认它存在；找不到报 ANCHOR_NOT_FOUND（不静默回落）", "properties": {"locator": {"type": "object", "minProperties": 1, "properties": {"controlType": {"type": "string", "minLength": 1}, "automationId": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "className": {"type": "string", "minLength": 1}, "matchMode": {"type": "string", "enum": ["exact", "contains", "regex"], "description": "控件级匹配方式（默认 exact）。uia 作用于 name/automationId；win32 作用于 title；controlType/className 恒等值"}, "path": {"type": "object", "minProperties": 1, "properties": {"controlType": {"type": "string", "minLength": 1}, "automationId": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "className": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "additionalProperties": false}}, "additionalProperties": false}}, "additionalProperties": false}, "timeoutMs": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "output_schema": {"type": "object", "required": ["elementId", "matchedCount"], "properties": {"elementId": {"type": "string"}, "matchedCount": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "errors": ["INVALID_INPUT", "ELEMENT_NOT_FOUND", "ELEMENT_AMBIGUOUS", "ANCHOR_NOT_FOUND", "SESSION_NOT_FOUND", "SESSION_LOST", "TIMEOUT", "CANCELLED", "EXECUTOR_FAILED"],
  "implementation": {"handler": "desktop.win32:find_element"},
  "default_timeout_seconds": 15,
  "retryable": true
}
