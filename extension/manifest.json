{
  "manifest_version": 3,
  "name": "rpa_core element capture",
  "version": "0.3.1",
  "description": "rpa_core 扩展：元素捕获 + 浏览器执行通道（Native Messaging 长连接，默认权限：整个浏览器）。",
  "update_url": "https://clients2.google.com/service/update2/crx",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "cookies",
    "downloads",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "rpa_core capture"
  }
}
