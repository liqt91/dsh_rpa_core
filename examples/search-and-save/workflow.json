{
  "schema_version": "1.0",
  "id": "search-and-save",
  "name": "Search deterministic site and save results",
  "inputs": {
    "url": "http://127.0.0.1:8765/",
    "keyword": "RPA Core",
    "workspace": ".",
    "outputPath": "run_artifacts/search-results.json"
  },
  "root": {
    "type": "sequence",
    "id": "root",
    "children": [
      {
        "type": "action",
        "id": "navigate",
        "command": "browser.navigate",
        "output_aliases": {"sessionId": "web"},
        "with": {"url": "${inputs.url}", "headless": true}
      },
      {
        "type": "action",
        "id": "setKeyword",
        "command": "data.setVar",
        "with": {"varName": "keyword", "value": "${inputs.keyword}"}
      },
      {
        "type": "action",
        "id": "input",
        "command": "browser.input",
        "with": {"sessionId": "${web}", "selector": "#query", "text": "${keyword}"}
      },
      {
        "type": "action",
        "id": "click",
        "command": "browser.click",
        "with": {"sessionId": "${web}", "selector": "button[type=submit]"}
      },
      {
        "type": "action",
        "id": "wait",
        "command": "browser.waitFor",
        "with": {"sessionId": "${web}", "selector": ".result"}
      },
      {
        "type": "action",
        "id": "collect",
        "command": "browser.queryAll",
        "output_aliases": {"items": "results"},
        "with": {"sessionId": "${web}", "selector": ".result"}
      },
      {
        "type": "action",
        "id": "save",
        "command": "data.writeJson",
        "with": {
          "workspace": "${inputs.workspace}",
          "path": "${inputs.outputPath}",
          "data": "${results}"
        }
      },
      {
        "type": "action",
        "id": "close",
        "command": "browser.close",
        "with": {"sessionId": "${web}"}
      },
      {
        "type": "return",
        "id": "return",
        "value": "${results}"
      }
    ]
  }
}
