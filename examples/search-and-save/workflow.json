{
  "schema_version": "1.0",
  "id": "search-and-save",
  "name": "Search deterministic site and save results",
  "inputs": {
    "url": "http://127.0.0.1:8765/",
    "keyword": "RPA Core",
    "workspace": ".",
    "outputPath": "run_artifacts/search-results.json"
  },
  "root": {
    "type": "sequence",
    "id": "root",
    "children": [
      {"type": "action", "id": "navigate", "command": "browser.navigate", "with": {"url": "${inputs.url}", "headless": true}},
      {"type": "action", "id": "input", "command": "browser.input", "with": {"sessionId": "${steps.navigate.outputs.sessionId}", "selector": "#query", "text": "${inputs.keyword}"}},
      {"type": "action", "id": "click", "command": "browser.click", "with": {"sessionId": "${steps.navigate.outputs.sessionId}", "selector": "button[type=submit]"}},
      {"type": "action", "id": "wait", "command": "browser.waitFor", "with": {"sessionId": "${steps.navigate.outputs.sessionId}", "selector": ".result"}},
      {"type": "action", "id": "collect", "command": "browser.queryAll", "with": {"sessionId": "${steps.navigate.outputs.sessionId}", "selector": ".result"}},
      {"type": "action", "id": "save", "command": "data.writeJson", "with": {"workspace": "${inputs.workspace}", "path": "${inputs.outputPath}", "data": "${steps.collect.outputs.items}"}},
      {"type": "action", "id": "close", "command": "browser.close", "with": {"sessionId": "${steps.navigate.outputs.sessionId}"}},
      {"type": "return", "id": "return", "value": "${steps.collect.outputs.items}"}
    ]
  }
}
