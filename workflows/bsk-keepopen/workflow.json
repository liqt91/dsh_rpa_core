{
  "schema_version": "1.0",
  "id": "bsk-keepopen",
  "name": "bsk keepOpen test",
  "inputs": {},
  "root": {
    "type": "sequence",
    "id": "root",
    "children": [
      {
        "type": "action",
        "id": "openPage",
        "command": "browser.navigate",
        "with": {
          "url": "https://example.com",
          "transport": "bsk",
          "keepOpen": true
        },
        "_exprModes": {}
      },
      {
        "type": "action",
        "id": "read",
        "command": "browser.getText",
        "with": {
          "sessionId": "${steps.openPage.outputs.sessionId}",
          "selector": "h1"
        }
      },
      {
        "type": "return",
        "id": "ret",
        "value": "${steps.read.outputs.value}"
      },
      {
        "type": "action",
        "id": "openPage2",
        "command": "browser.navigate",
        "with": {
          "url": "https://example.com",
          "transport": "bsk"
        }
      }
    ]
  }
}
