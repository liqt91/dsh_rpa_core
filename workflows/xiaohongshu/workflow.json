{
  "schema_version": "1.0",
  "id": "xiaohongshu",
  "name": "xiaohongshu",
  "inputs": {},
  "root": {
    "type": "sequence",
    "id": "root",
    "children": [
      {
        "type": "action",
        "id": "n1",
        "command": "data.setVar",
        "with": {
          "varName": "url",
          "value": "\"www.xiaohongshu.com\""
        },
        "_exprModes": {
          "value": "python"
        }
      },
      {
        "type": "action",
        "id": "n2",
        "command": "browser.navigate",
        "with": {
          "browserType": "chrome",
          "url": "[url]",
          "action": "goto"
        },
        "_exprModes": {
          "url": "fx"
        }
      },
      {
        "type": "action",
        "id": "n3",
        "command": "browser.input",
        "with": {
          "text": "摄影",
          "mode": "clipboard",
          "pressEnter": true,
          "clickBeforeInput": true
        },
        "elementRefs": {
          "selector": "input_el_textarea"
        }
      }
    ]
  }
}
