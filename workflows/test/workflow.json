{
  "schema_version": "1.0",
  "id": "draft",
  "name": "未命名工作流",
  "inputs": {},
  "root": {
    "type": "sequence",
    "id": "root",
    "children": [
      {
        "type": "action",
        "id": "setVar",
        "command": "data.setVar",
        "with": {
          "varName": "url",
          "varType": "string",
          "value": "xiaohongshu.com"
        }
      },
      {
        "type": "action",
        "id": "navigate",
        "command": "browser.navigate",
        "with": {
          "browserType": "chrome",
          "action": "goto",
          "url": "${url}",
          "onTimeout": "error"
        },
        "_exprModes": {
          "url": "fx"
        }
      },
      {
        "type": "action",
        "id": "n1",
        "command": "browser.input",
        "with": {
          "selector": "#search-input-in-feeds",
          "text": "摄影",
          "mode": "type",
          "append": false,
          "pressEnter": true,
          "clickBeforeInput": true
        },
        "elementRefs": {
          "selector": "el_textarea"
        }
      }
    ]
  }
}
