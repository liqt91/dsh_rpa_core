{
  "schema_version": "1.0",
  "id": "draft",
  "name": "未命名工作流",
  "inputs": {},
  "root": {
    "type": "sequence",
    "id": "root",
    "children": [
      {
        "type": "action",
        "id": "setVar",
        "command": "data.setVar",
        "with": {
          "varType": "string",
          "varName": "url",
          "value": "baidu.com"
        },
        "_exprModes": {}
      },
      {
        "type": "action",
        "id": "navigate",
        "command": "browser.navigate",
        "with": {
          "browserType": "chrome",
          "action": "goto",
          "url": "${url}",
          "onTimeout": "error"
        },
        "_exprModes": {
          "url": "fx"
        }
      }
    ]
  }
}
