{
  "manifest_version": 3,
  "name": "WorkBuddy Studio · Element Picker",
  "version": "1.0.0",
  "description": "在页面上点一个元素，把稳定选择器直接交给 WorkBuddy Agent —— 不独立运行，只做 Agent 的取景器。",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WorkBuddy Studio · 拾取元素",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "开始拾取页面元素"
    }
  }
}
