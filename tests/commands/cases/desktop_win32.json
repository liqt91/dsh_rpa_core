  "desktop.win32.getWindowList": {
    "notes": "不需要会话。与 uia 侧同一口径：outputs 是整桌面的窗口列表，内容随本机环境漂移，所以正路径只断言形状，唯一按值断言的是『一个都不匹配 → 空列表』。",
    "variants": [
      {
        "name": "exact-pattern-finds-the-fixture-window",
        "inputs": {
          "titlePattern": "{appTitle}",
          "matchMode": "exact"
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "outputKeys": [
            "windows"
          ],
          "effect": "read"
        }
      },
      {
        "name": "contains-pattern-finds-a-title-substring",
        "inputs": {
          "titlePattern": "Desktop Demo",
          "matchMode": "contains"
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "outputKeys": [
            "windows"
          ],
          "effect": "read"
        }
      },
      {
        "name": "regex-pattern-matches-the-fixture-window",
        "inputs": {
          "titlePattern": "^RPA Core .*Demo$",
          "matchMode": "regex"
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "outputKeys": [
            "windows"
          ],
          "effect": "read"
        }
      },
      {
        "name": "unknown-pattern-yields-an-empty-list",
        "inputs": {
          "titlePattern": "no-such-window-probe-xyz-42",
          "matchMode": "exact"
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "outputs": {
            "windows": []
          },
          "effect": "read"
        },
        "negative": true
      },
      {
        "name": "no-filter-declares-every-window",
        "inputs": {},
        "setup": {
          "session": "none"
        },
        "expect": {
          "outputKeys": [
            "windows"
          ],
          "effect": "read"
        }
      }
    ]
  },
