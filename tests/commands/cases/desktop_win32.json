          "height": 600
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      }
    ]
  },
  "desktop.win32.screenshot": {
    "notes": "**S2.3 起依赖已定案**：加 Pillow（同 uia 侧说明，见 cases/desktop.json 的 `desktop.screenshot`）。win32 侧没有 UIA 图像属性，直接走 `capture_as_image()` 回落路径。",
    "variants": [
      {
        "name": "writes-a-png-into-the-variant-temp-dir",
        "notes": "锚点选只读 Edit（窗口文本恒为 'note-ready'，不被任何命令改写）——与 getText 正路径同一个锚点，理由相同。",
