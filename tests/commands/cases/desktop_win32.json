{
  "desktop.win32.activateWindow": {
    "notes": "会话级命令，与 uia 侧同构。它会真的抢前台焦点。",
    "variants": [
      {
        "name": "activates-the-session-window",
        "inputs": {
          "sessionId": "{session}"
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "missing-session-is-explicit",
        "inputs": {
          "sessionId": "no-such-session"
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "empty-session-string-is-not-a-wildcard",
        "inputs": {
          "sessionId": ""
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      }
    ]
  },
  "desktop.win32.attachWindow": {
    "notes": "比 uia 侧多一个 handle 参数（直连分支：不枚举、不按标题匹配，直接按句柄构造）。expect 的形状依据与 uia 侧同一组契约测试（test_desktop_contract.py / test_desktop_attach_window.py 断言两后端在这条命令上一致：outputs 四键、INVALID_INPUT、ELEMENT_NOT_FOUND + matchedCount / className）。",
    "variants": [
      {
        "name": "exact-title-binds-the-fixture-window",
        "notes": "显式给出 operationTimeoutMs 的一个取值（两侧覆盖要求）。",
        "inputs": {
          "title": "{appTitle}",
          "matchMode": "exact",
          "timeoutMs": 5000,
          "operationTimeoutMs": 2000
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "outputs": {
            "resourceType": "windowHandle"
          },
          "outputKeys": [
            "sessionId",
            "resourceType",
            "processId",
            "workWindowId"
          ],
          "effect": "session"
        }
      },
      {
        "name": "contains-mode-matches-a-title-substring",
        "inputs": {
          "title": "Desktop Demo",
          "matchMode": "contains",
          "timeoutMs": 5000,
          "operationTimeoutMs": 4000
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "outputKeys": [
            "sessionId",
            "workWindowId"
          ],
          "effect": "session"
        }
      },
      {
        "name": "regex-mode-matches-the-whole-title",
        "inputs": {
          "title": "^RPA Core .*Demo$",
          "matchMode": "regex",
          "timeoutMs": 5000
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "outputKeys": [
            "sessionId"
          ],
          "effect": "session"
        }
      },
      {
        "name": "handle-connects-without-any-title-matching",
        "notes": "handle 直连是 win32 侧独有的快路径：不枚举、不比标题。句柄由装配用 FindWindowW 现取（每次运行都不同，写不进表里）。",
        "inputs": {
          "handle": "{handle}",
          "timeoutMs": 5000
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "outputKeys": [
            "sessionId",
            "workWindowId"
          ],
          "outputs": {
            "workWindowId": "{handle}"
          },
          "effect": "session"
        }
      },
      {
        "name": "unknown-handle-is-not-found",
        "inputs": {
          "handle": "999999999",
          "timeoutMs": 200
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "class-name-is-compared-by-equality-and-can-miss",
        "inputs": {
          "title": "{appTitle}",
          "className": "Notepad",
          "timeoutMs": 200
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND",
          "errorDetails": {
            "className": "Notepad"
          }
        },
        "negative": true
      },
      {
        "name": "no-filter-at-all-is-invalid-input",
        "inputs": {},
        "setup": {
          "session": "none"
        },
        "expect": {
          "errorCode": "INVALID_INPUT"
        },
        "negative": true
      },
      {
        "name": "process-id-narrows-to-the-fixture-process",
        "inputs": {
          "title": "{appTitle}",
          "processId": "{pid}",
          "timeoutMs": 5000
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "outputs": {
            "processId": "{pid}"
          },
          "outputKeys": [
            "sessionId"
          ],
          "effect": "session"
        }
      },
      {
        "name": "unknown-process-id-is-not-found",
        "inputs": {
          "title": "{appTitle}",
          "processId": 999999,
          "timeoutMs": 200
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "unknown-title-reports-zero-matches",
        "inputs": {
          "title": "no-such-window-rpa-core-probe",
          "timeoutMs": 200
        },
        "setup": {
          "session": "none"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND",
          "errorDetails": {
            "matchedCount": 0
          }
        },
        "negative": true
      }
    ]
  },
  "desktop.win32.click": {
    "notes": "**当前只有负路径**：靶子的控件是 WinForms 动态类名（WindowsForms10.BUTTON.app.0.xxx）、没有稳定的 controlId，win32 定位器（title / className / controlId）匹配不到它们——所以所有吃 elementId 的变体都只能走『元素不存在』这条确定路径。需要正路径得先给靶子加一套 Win32 可定位的控件（登记在任务单 §3）。负路径本身仍有价值：它钉住了参数被接受、且失败码与 uia 侧一致。",
    "variants": [
      {
        "name": "default-values-are-spelled-out",
        "notes": "四个缺省值显式写出来，否则没有任何变体『出现』过这些枚举值（覆盖校验会红）；timeoutMs=200 是等待预算的短侧取值。",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "clickType": "single",
          "button": "left",
          "clickPosition": "center",
          "postDelayMs": 0,
          "timeoutMs": 200
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "double-click-type-is-accepted",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "clickType": "double"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "right-button-is-accepted",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "button": "right"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "modifiers-are-accepted",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "modifiers": [
            "Ctrl",
            "Shift"
          ]
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "simulate-human-false-is-accepted",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "simulateHuman": false
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "random-position-is-accepted",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "clickPosition": "random"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "post-delay-is-accepted",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "postDelayMs": 120
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "timeout-budget-is-accepted",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "timeoutMs": 2000
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "missing-session-is-explicit",
        "inputs": {
          "sessionId": "no-such-session",
          "elementId": "no-such-element"
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      }
    ]
  },
  "desktop.win32.closeSession": {
    "notes": "与 uia 侧同构：用自己那个会话，不影响别的变体。forceKill 只覆盖缺省 false（true 会结束靶子进程）。",
    "variants": [
      {
        "name": "closes-a-session-it-owns",
        "inputs": {
          "sessionId": "{session}",
          "forceKill": false
        },
        "expect": {
          "effect": "session"
        }
      },
      {
        "name": "missing-session-is-explicit",
        "inputs": {
          "sessionId": "no-such-session"
