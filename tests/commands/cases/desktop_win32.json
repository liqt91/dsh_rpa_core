      {
        "name": "clicks-a-button-through-a-win32-element",
        "notes": "正路径：显式写全缺省值（clickType/button/clickPosition/postDelayMs）。",
        "setup": {
          "find": {
            "count": {
              "backend": "win32",
              "title": "Count"
            }
          }
        },
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:count}",
          "clickType": "single",
          "button": "left",
          "clickPosition": "center",
          "postDelayMs": 0
