        },
        "negative": true
      }
    ]
  },
  "desktop.win32.drag": {
    "notes": "与 uia 侧同构：靶子无可拖控件，且真机拖动会操作真实鼠标（外部副作用），所以只覆盖『目标不存在时显式失败』。",
    "variants": [
      {
        "name": "unknown-element-id-is-element-not-found",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "targetX": 100,
          "targetY": 100
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "target-far-outside-the-element-still-fails-on-the-element-first",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "targetX": 99999,
          "targetY": 99999
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "missing-session-is-explicit",
        "inputs": {
          "sessionId": "no-such-session",
          "elementId": "no-such-element",
          "targetX": 0,
          "targetY": 0
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      }
    ]
  },
  "desktop.win32.findElement": {
    "notes": "**当前只有负路径**，原因同 click：win32 定位器认 title / className / controlId，而靶子控件的类名是 WinForms 动态生成的、没有稳定 controlId。locator 里的 backend 字段必须显式写成 win32——DesktopLocator 按后端校验必填身份字段，缺了会在模型层就报 ValidationError（不是本命令的错）。",
    "variants": [
      {
        "name": "unknown-class-name-is-element-not-found",
        "inputs": {
          "sessionId": "{session}",
          "locator": {
            "backend": "win32",
            "className": "NoSuchControlClass"
          },
          "timeoutMs": 200
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "longer-wait-budget-is-accepted",
        "inputs": {
          "sessionId": "{session}",
          "locator": {
            "backend": "win32",
            "className": "NoSuchControlClass"
          },
          "timeoutMs": 2000
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "missing-session-is-explicit",
        "inputs": {
          "sessionId": "no-such-session",
          "locator": {
            "backend": "win32",
            "className": "NoSuchControlClass"
          }
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "empty-session-string-is-not-a-wildcard",
        "inputs": {
          "sessionId": "",
          "locator": {
            "backend": "win32",
            "className": "NoSuchControlClass"
          }
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      }
    ]
  },
