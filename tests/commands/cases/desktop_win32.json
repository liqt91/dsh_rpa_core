      {
        "name": "empty-session-falls-back-then-the-element-is-missing",
        "inputs": {
          "sessionId": "",
          "elementId": "no-such-element",
          "savePath": "{tmp}/nope.png"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true,
        "notes": "空会话串的实测语义（2026-09-22 执行层首跑校正）：`resolve_session_id` 把空串当「未提供」（`str(requested or '').strip()` 为空即回退），于是命令落到**默认会话**上，并不存在「拿空串去匹配某个会话」这一步——这才是『空串不是通配符』的真实含义。 但本命令还要元素：回退成功之后，失败点变成了那个不存在的元素 id（不是会话）。"
      }
    ]
  },
  "desktop.win32.select": {
    "notes": "**BACKLOG 尾巴 #1 实现后重写（2026-09-23）**：改走原生 LB_SETCURSEL / CB_SETCURSEL（pywinauto 包装类已封装跨进程缓冲区），三个 selectBy 分支第一次有了正路径。与 uia 侧的一个重要差别：pywinauto 的 select() 在原生消息之后会 `notify_parent(LBN_SELCHANGE / CBN_SELCHANGE)`（post 一个 WM_COMMAND），所以 WinForms 的 SelectedIndexChanged **会**触发、状态回显控件会跟着变（实测 listStatus 逐步 none → list:1:beta → list:2:gamma → list:0:alpha）——uia 那条 SelectionItemPattern.Select() 不触发，故 uia 侧只能靠 details 读回。两者都写 `selectedItem`，断言口径可跨后端复用。`index` 分支的越界/非数字都收敛到 ELEMENT_NOT_FOUND（三 selectBy 共用同一失败语义）。定位必须按 `{listBoxClass}` / `{comboBoxClass}`：这两个控件窗口文本恒空、`controlId` 每次进程启动都漂。",
    "variants": [
      {
        "name": "value-mode-selects-on-the-listbox",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:options}",
          "value": "beta",
          "selectBy": "value"
        },
        "setup": {
          "find": {
            "options": {
              "backend": "win32",
              "className": "{listBoxClass}"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write",
          "effectDetails": {
            "operation": "selectOption",
            "selectBy": "value",
            "selectedItem": "beta"
          }
        }
      },
      {
        "name": "label-mode-selects-on-the-listbox",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:options}",
          "value": "gamma",
          "selectBy": "label"
        },
        "setup": {
          "find": {
            "options": {
              "backend": "win32",
              "className": "{listBoxClass}"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write",
          "effectDetails": {
            "operation": "selectOption",
            "selectBy": "label",
            "selectedItem": "gamma"
          }
        }
      },
      {
        "name": "index-mode-selects-on-the-listbox",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:options}",
          "value": "0",
          "selectBy": "index"
        },
        "setup": {
          "find": {
            "options": {
              "backend": "win32",
              "className": "{listBoxClass}"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write",
          "effectDetails": {
            "operation": "selectOption",
            "selectBy": "index",
            "selectedItem": "alpha"
          }
        }
      },
      {
        "name": "value-mode-selects-on-the-combobox",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:options}",
          "value": "two",
          "selectBy": "value"
        },
        "setup": {
          "find": {
            "options": {
              "backend": "win32",
              "className": "{comboBoxClass}"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write",
          "effectDetails": {
            "operation": "selectOption",
            "selectBy": "value",
            "selectedItem": "two"
          }
        }
      },
      {
        "name": "index-mode-selects-on-the-combobox",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:options}",
          "value": "2",
          "selectBy": "index"
        },
        "setup": {
          "find": {
            "options": {
              "backend": "win32",
              "className": "{comboBoxClass}"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write",
          "effectDetails": {
            "operation": "selectOption",
            "selectBy": "index",
            "selectedItem": "three"
          }
        }
      },
      {
        "name": "no-such-item-is-element-not-found",
        "notes": "列表只有 alpha/beta/gamma 三项；details 里的 enumerableItems 是实现的证据面（与 uia 侧同键名）。",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:options}",
          "value": "delta",
          "selectBy": "label"
        },
        "setup": {
          "find": {
            "options": {
              "backend": "win32",
              "className": "{listBoxClass}"
            }
          }
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND",
          "errorDetails": {
            "operation": "selectOption",
            "enumerableItems": 3
          }
        },
        "negative": true
      },
      {
        "name": "index-out-of-range-is-element-not-found",
        "notes": "越界索引在**选中之前**被拦下（不是把 LB_SETCURSEL 打过去再说）——所以这条同时也是「没有偷偷改状态」的判据。",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:options}",
          "value": "9",
          "selectBy": "index"
        },
        "setup": {
          "find": {
            "options": {
              "backend": "win32",
              "className": "{listBoxClass}"
            }
          }
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND",
          "errorDetails": {
            "operation": "selectOption",
            "enumerableItems": 3
          }
        },
        "negative": true
      },
      {
        "name": "non-numeric-index-is-element-not-found",
        "notes": "selectBy=index 而 value 不是数字：int() 失败收敛成 -1 再走同一越界判断，不抛异常、也不落到 EXECUTOR_FAILED。",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:options}",
          "value": "not-a-number",
          "selectBy": "index"
        },
        "setup": {
          "find": {
            "options": {
              "backend": "win32",
              "className": "{listBoxClass}"
            }
          }
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND",
          "errorDetails": {
            "operation": "selectOption",
            "enumerableItems": 3
          }
        },
        "negative": true
      },
      {
        "name": "value-mode-fails-on-an-unknown-element",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "value": "option-a",
          "selectBy": "value"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "label-mode-fails-on-an-unknown-element",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "value": "option-a",
          "selectBy": "label"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "index-mode-fails-on-an-unknown-element",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "value": "0",
          "selectBy": "index"
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "missing-session-is-explicit",
        "inputs": {
          "sessionId": "no-such-session",
          "elementId": "no-such-element",
          "value": "option-a"
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "rejects-a-non-list-element",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:submit}",
          "value": "one",
          "selectBy": "label"
        },
        "setup": {
          "find": {
            "submit": {
              "backend": "win32",
              "title": "Submit"
            }
          }
        },
        "expect": {
          "errorCode": "EXECUTOR_FAILED",
          "errorDetails": {
            "operation": "selectOption",
            "selectBy": "label"
          }
        },
        "negative": true,
        "notes": "**S2.3 时叫 `reports-unsupported-backend-explicitly`**（钉「后端整个不支持」）。原生消息落地后判据收窄成「元素不是列表控件」，故改名；details 里 `selectBy` 回带请求参数，便于定位。"
      }
    ]
  },
