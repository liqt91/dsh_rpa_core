        "name": "explicit-relative-path-stays-inside-flow-dir",
        "setup": {
          "table": {
            "path": "flow/data/table.json",
            "data": {
              "columns": [
                {
                  "key": "文本",
                  "label": "文本",
                  "type": "text"
                }
              ],
              "rows": [
                {
                  "文本": "a,b"
                }
              ]
            }
          }
        },
        "inputs": {
          "flowDir": "{tmp}/flow",
          "path": "out/导出.csv"
        },
        "expect": {
          "outputPaths": {
            "path": "{tmp}/flow/out/导出.csv"
          },
          "files": [
            {
              "path": "flow/out/导出.csv",
              "equals": "\ufeff文本\n\"a,b\"\n"
            }
          ]
        }
      },
      {
        "name": "quotes-and-json-encodes-awkward-cells",
        "notes": "含逗号/引号的格按 CSV 规则转义；缺失列留空；dict 值先 JSON 序列化再转义。",
        "setup": {
          "table": {
            "path": "flow/data/table.json",
            "data": {
              "columns": [
                {
                  "key": "文本",
                  "label": "文本",
                  "type": "text"
                },
                {
                  "key": "备注",
                  "label": "备注",
                  "type": "text"
                }
              ],
              "rows": [
                {
                  "文本": "a,b",
                  "备注": {
                    "k": 1
                  }
                },
                {
                  "文本": "has \"quote\"",
                  "备注": null
                }
              ]
            }
          }
        },
        "inputs": {
          "flowDir": "{tmp}/flow"
        },
        "expect": {
          "files": [
            {
              "path": "flow/data/table.csv",
              "equals": "\ufeff文本,备注\n\"a,b\",\"{\"\"k\"\": 1}\"\n\"has \"\"quote\"\"\",\n"
            }
          ]
        }
      },
      {
        "name": "named-table-defaults-to-its-own-csv-name",
        "notes": "缺省导出路径由**表名**推导（`<flow_dir>/data/<table>.csv`），不是固定 `table.csv`——多表流程里这条错了会互相覆盖。",
        "setup": {
          "table": {
            "path": "flow/data/other.json",
            "data": {
              "columns": [
                {
                  "key": "k",
                  "label": "k",
                  "type": "text"
                }
              ],
              "rows": [
                {
                  "k": "v"
                }
              ]
            }
          }
        },
        "inputs": {
          "flowDir": "{tmp}/flow",
          "table": "other"
        },
        "expect": {
          "outputPaths": {
            "path": "{tmp}/flow/data/other.csv"
          },
          "files": [
            {
              "path": "flow/data/other.csv",
              "equals": "\ufeffk\nv\n"
            }
          ]
        }
      },
      {
        "name": "path-outside-flow-dir-is-denied",
        "inputs": {
          "flowDir": "{tmp}/flow",
          "path": "{tmp}/escape.csv"
        },
        "expect": {
          "errorCode": "CAPABILITY_DENIED",
          "files": [
            {
              "path": "escape.csv",
              "missing": true
            }
          ]
        },
        "negative": true
      }
    ]
  }
