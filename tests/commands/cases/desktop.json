              "automationId": "optionsList"
            }
          }
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      }
    ]
  },
  "desktop.setWindowState": {
    "notes": "三个状态各一个变体。minimized 放在最后一个：它真的会把窗口最小化，虽然装配在每个变体前都会重新抢前台，但把破坏性最强的放最后能少依赖一次恢复。",
    "variants": [
      {
        "name": "normal-state-is-applied",
        "inputs": {
          "sessionId": "{session}",
          "state": "normal"
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "maximized-state-is-applied",
        "inputs": {
          "sessionId": "{session}",
          "state": "maximized"
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "minimized-state-is-applied",
        "inputs": {
          "sessionId": "{session}",
          "state": "minimized"
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "missing-session-is-explicit",
        "inputs": {
          "sessionId": "no-such-session",
          "state": "normal"
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      }
    ]
  },
  "desktop.setWindowVisible": {
    "notes": "只覆盖 visible=true 的正路径：visible=false 会把窗口藏起来，后续变体的 attach 未必还能拿到它（隐藏窗口不参与前台激活），那是拿整个矩阵的稳定性换一个布尔分支。隐藏/恢复这一对需要在一个变体内部完成（属于流程层）。",
    "variants": [
      {
        "name": "visible-true-is-applied",
        "inputs": {
          "sessionId": "{session}",
          "visible": true
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "missing-session-is-explicit",
        "inputs": {
          "sessionId": "no-such-session",
          "visible": true
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "empty-session-string-falls-back-to-the-default-session",
        "inputs": {
          "sessionId": "",
          "visible": true
        },
        "expect": {
          "effect": "unsafe-write"
        },
        "notes": "空会话串的实测语义（2026-09-22 执行层首跑校正）：`resolve_session_id` 把空串当「未提供」（`str(requested or '').strip()` 为空即回退），于是命令落到**默认会话**上，并不存在「拿空串去匹配某个会话」这一步——这才是『空串不是通配符』的真实含义。 本命令只吃会话，所以回退之后就是一次正常执行；`missing-session-is-explicit` 那条才是真正的失败路径。"
      }
    ]
  }
