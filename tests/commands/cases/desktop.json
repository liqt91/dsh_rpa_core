  "desktop.input": {
    "notes": "靶子输入框是共享的，所以按值断言『读回来的就是刚写进去的』会受变体顺序影响，留给真机 E2E。这里覆盖的是三个 mode、append、keyIntervalMs、clickBeforeInput、postDelayMs 这些参数分支的效果与耗时。",
    "variants": [
      {
        "name": "default-simulate-human-mode-writes-text",
        "notes": "与 click 的同名变体同理：mode=simulateHuman 是缺省值，不显式写出来就没有变体覆盖它；postDelayMs 也要两侧取值。",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:input}",
          "text": "matrix",
          "mode": "simulateHuman",
          "timeoutMs": 2000,
          "postDelayMs": 0
        },
        "setup": {
          "find": {
            "input": {
              "automationId": "queryInput",
              "controlType": "Edit"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "clipboard-mode-is-accepted",
        "notes": "**首次启用时需要确认这条**：clipboard 模式要写系统剪贴板 + 合成 Ctrl+V，而 tests/conftest.py 的 _block_global_input 会把全局输入面（剪贴板/键击）钉住。若它拦下了这里的剪贴板写入，本变体会红在桩的 AssertionError 上——那是**预期内的环境结论**（该模式在缺省隔离下不可用），届时把此变体改成断言显式失败即可，别去改实现。",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:input}",
          "text": "clip",
          "mode": "clipboard"
        },
        "setup": {
          "find": {
            "input": {
              "automationId": "queryInput",
              "controlType": "Edit"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "automation-mode-writes-without-synthesized-keys",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:input}",
          "text": "auto",
          "mode": "automation"
        },
        "setup": {
          "find": {
            "input": {
              "automationId": "queryInput",
              "controlType": "Edit"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "append-adds-instead-of-replacing",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:input}",
          "text": "+more",
          "append": true
        },
        "setup": {
          "find": {
            "input": {
              "automationId": "queryInput",
              "controlType": "Edit"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "zero-key-interval-types-without-pausing",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:input}",
          "text": "fast",
          "keyIntervalMs": 0
        },
        "setup": {
          "find": {
            "input": {
              "automationId": "queryInput",
              "controlType": "Edit"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "key-interval-is-consumed-as-real-waiting",
        "notes": "41 字 × 80ms 在 S2.1 的真机 E2E 里实测过 3735ms，所以这里用墙钟下界证明『逐字敲』没被静默忽略（这是 M28 S3 查出过的那类漂移）。",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:input}",
          "text": "interval probe",
          "keyIntervalMs": 80
        },
        "setup": {
          "find": {
            "input": {
              "automationId": "queryInput",
              "controlType": "Edit"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write",
          "elapsedAtLeastMs": 600
        }
      },
      {
        "name": "click-before-input-is-consumed",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:input}",
          "text": "clicked",
          "clickBeforeInput": true
        },
        "setup": {
          "find": {
            "input": {
              "automationId": "queryInput",
              "controlType": "Edit"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write"
        }
      },
      {
        "name": "post-delay-is-consumed",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "{element:input}",
          "text": "delayed",
          "postDelayMs": 150
        },
        "setup": {
          "find": {
            "input": {
              "automationId": "queryInput",
              "controlType": "Edit"
            }
          }
        },
        "expect": {
          "effect": "unsafe-write",
          "elapsedAtLeastMs": 150
        }
      },
      {
        "name": "unknown-element-id-is-element-not-found",
        "inputs": {
          "sessionId": "{session}",
          "elementId": "no-such-element",
          "text": "nope",
          "timeoutMs": 200
        },
        "expect": {
          "errorCode": "ELEMENT_NOT_FOUND"
        },
        "negative": true
      },
      {
        "name": "missing-session-is-explicit",
        "inputs": {
          "sessionId": "no-such-session",
          "elementId": "no-such-element",
          "text": "nope"
        },
        "expect": {
          "errorCode": "SESSION_NOT_FOUND"
        },
        "negative": true
      }
    ]
  },
